import csv

with open("plant_tasks.csv", encoding="utf-8") as f:
    tasks = list(csv.DictReader(f))

total = 0
busiest = ""
most = 0
for row in tasks:
    trips = int(row["trips_per_day"])
    total = total + trips
    if trips > most:
        most = trips
        busiest = row["task_id"]
print(total, busiest)
